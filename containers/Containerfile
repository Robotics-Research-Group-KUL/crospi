# syntax=docker/dockerfile:1.4
#
# Crospi user container (crospi + betfsm built in /opt/ros2_crospi_ws), for every supported ROS 2 distribution.
# Published as ghcr.io/robotics-research-group-kul/crospi-betfsm:ros2-<distro>. It works with podman and docker
# (no user is created in the image: distrobox creates it, or use docker run --user, see the documentation):
#   podman build --build-arg ROS_DISTRO=<humble|jazzy|kilted|lyrical|rolling> -f containers/Containerfile -t crospi-betfsm:ros2-<distro> .
#   docker build --build-arg ROS_DISTRO=<humble|jazzy|kilted|lyrical|rolling> -f containers/Containerfile -t crospi-betfsm:ros2-<distro> .
#
# The build dependencies of the crospi packages are declared in their package.xml files and installed by rosdep.
# This file only adds what rosdep cannot install (Lua rocks, pip-only python packages) and the user tools.

ARG ROS_DISTRO=kilted
FROM docker.io/osrf/ros:${ROS_DISTRO}-desktop
ARG ROS_DISTRO
ENV MY_ROS_DISTRO=${ROS_DISTRO}

ENV DEBIAN_FRONTEND=noninteractive
# Build-time only (ARG, not ENV): pip >= 23 refuses system-wide installs on Ubuntu >= 24.04 without it;
# older pip (Ubuntu 22.04) ignores it
ARG PIP_BREAK_SYSTEM_PACKAGES=1

# 1. System packages: tools, Lua (task specifications), python packages available through apt
RUN apt-get update && apt-get install -y \
    git python3-pip python3-venv vim tree wget curl ca-certificates \
    lua5.1 liblua5.1.0-dev luarocks cmake build-essential ros-dev-tools software-properties-common \
    lsb-release libssl-dev procps passwd adduser libcap2-bin \
    openssh-client tmux libgl1-mesa-dri libgl1 \
    python3-numpy python3-scipy python3-pandas python3-matplotlib \
    && rm -rf /var/lib/apt/lists/*

# Nice to have: PlotJuggler (not yet released for every distribution)
RUN apt-get update \
    && (apt-get install -y ros-${ROS_DISTRO}-plotjuggler-ros \
        || echo "ros-${ROS_DISTRO}-plotjuggler-ros is not available for ${ROS_DISTRO}, skipped") \
    && rm -rf /var/lib/apt/lists/*

# 2. Lua rocks used by the task specifications. lrexlib-pcre (dependency of jsonschema) needs PCRE 1 (pcre.h):
#    from libpcre3-dev where available, built from source otherwise (libpcre3 was dropped in Ubuntu 26.04)
RUN apt-get update \
    && if apt-cache show libpcre3-dev > /dev/null 2>&1; then \
         apt-get install -y libpcre3-dev && luarocks install lrexlib-pcre; \
       else \
         cd /tmp && wget https://sourceforge.net/projects/pcre/files/pcre/8.45/pcre-8.45.tar.gz \
         && tar xzf pcre-8.45.tar.gz && cd pcre-8.45 && ./configure && make && make install && ldconfig \
         && cd /tmp && rm -rf pcre-8.45 pcre-8.45.tar.gz \
         && luarocks install lrexlib-pcre PCRE_DIR="/usr/local"; \
       fi \
    && luarocks install net-url \
    && luarocks install dkjson \
    && luarocks install jsonschema \
    && rm -rf /var/lib/apt/lists/*

# 3. Fake Root Permissions
RUN echo "%sudo ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/nopasswd

# 4. Python packages (system-wide) used by crospi_application_template and betfsm. jsonref has no apt package/rosdep
#    rule and is always installed with pip. Up to Ubuntu 24.04 the others are installed with pip (recent versions);
#    from Ubuntu 26.04 on, they are taken from apt where possible.
#    --ignore-installed prevents pip from trying to uninstall packages that were installed via apt (e.g. typing-extensions)
RUN . /etc/os-release \
    && if dpkg --compare-versions "$VERSION_ID" ge 26.04; then \
         apt-get update \
         && apt-get install -y python3-colorama python3-requests python3-uvicorn python3-websockets python3-fastapi ipython3 \
         && rm -rf /var/lib/apt/lists/* \
         && pip3 install --no-cache-dir --ignore-installed jsonref jsonschema plotly; \
       else \
         pip3 install --no-cache-dir --ignore-installed jsonref jsonschema colorama requests uvicorn websockets fastapi \
         && pip3 install --no-cache-dir --ignore-installed ipython plotly; \
       fi

# 5. Build the BASE Workspace in /opt (Accessible to all users)
# We use /opt because Distrobox does NOT overwrite this folder.
ENV BASE_WS=/opt/ros2_crospi_ws
RUN mkdir -p $BASE_WS/src
WORKDIR $BASE_WS

RUN git clone --recursive https://github.com/Robotics-Research-Group-KUL/crospi.git src/crospi \
    && git clone --recursive https://github.com/Robotics-Research-Group-KUL/betfsm.git src/betfsm

# Install the dependencies declared in the package.xml files and build.
RUN /bin/bash -c '\
    apt-get update && \
    (rosdep init || true) && \
    rosdep update --rosdistro $ROS_DISTRO && \
    source /opt/ros/$ROS_DISTRO/setup.bash && \
    rosdep install --from-paths src -y --ignore-src --rosdistro $ROS_DISTRO && \
    colcon build --symlink-install && \
    rm -rf /var/lib/apt/lists/* \
'

# 6. Global Sourcing
# We add the source command to the GLOBAL bashrc so every user has it automatically
RUN echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash " >> /etc/bash.bashrc
RUN echo 'source $BASE_WS/src/crospi/custom_aliases_crospi.sh' >> /etc/bash.bashrc
RUN echo "source $BASE_WS/install/setup.bash" >> /etc/bash.bashrc

WORKDIR /
CMD ["/usr/bin/bash"]
